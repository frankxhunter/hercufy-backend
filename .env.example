# Copia este archivo como .env y rellena los valores. No subas nunca el .env real.

# Base de datos (coincide con docker-compose.yml)
MY_DATABASE_URL=jdbc:postgresql://localhost:5432/hercufy
MY_USER=hercufy
MY_PASSWORD=changeme
MY_DATABASE=hercufy

# JWT: genera un secreto propio, por ejemplo con `openssl rand -base64 48`
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=2592000000

# Correo (verificacion de email). Puedes dejarlo vacio por ahora: el registro
# seguira funcionando y el intento de envio fallido solo queda avisado en el log
# (ver EmailService). Rellena esto cuando tengas un proveedor SMTP.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# URL del frontend, usada para construir el enlace de confirmacion de email
FRONTEND_BASE_URL=http://localhost:4200

# Origenes adicionales permitidos por CORS, separados por coma. Por defecto ya se
# permiten localhost (cualquier puerto), https://localhost y capacitor://localhost (el
# WebView del APK/IPA) y toda la red privada (192.168.*, 10.*, 172.16-31.*) para poder
# probar en el movil. En produccion acota esto a tus dominios.
CORS_ALLOWED_ORIGINS=

# Login con Google (opcional; el backend lo soporta pero el frontend no lo usa todavia)
GOOGLE_CLIENT_ID=

# Catalogo de ejercicios: de donde se sirven las imagenes. Por defecto apunta al
# repositorio de free-exercise-db en GitHub; cambialo cuando tengas tu propio storage.
EXERCISE_IMAGES_BASE_URL=https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/
